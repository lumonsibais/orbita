# Copia este archivo a infra/.env:  cp infra/.env.example infra/.env
# Son contraseñas solo para tu máquina; dev, qa y prod usan otras, guardadas en GitHub.
# Si cambias alguna después del primer arranque, borra el volumen (ver README).

# Puerto de tu máquina donde queda MySQL. Si ya tienes otro MySQL en el 3306, usa 3307
# y cambia también el puerto en las DATABASE_URL de backend/.env
MYSQL_PORT=3306

MYSQL_ROOT_PASSWORD=root_local
IDENTITY_DB_PASSWORD=identity_local
NEO_DB_PASSWORD=neo_local
WATCHLIST_DB_PASSWORD=watchlist_local
MEDIA_DB_PASSWORD=media_local
