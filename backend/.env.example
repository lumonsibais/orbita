# Copia este archivo a backend/.env:  cp backend/.env.example backend/.env
# Toda variable nueva se agrega aquí, en orbita/config.py y en los secretos de dev y qa.

# local | dev | qa | prod
APP_ENV=local
LOG_LEVEL=DEBUG

# Una conexión por módulo, cada una con su usuario (las contraseñas salen de infra/.env)
DATABASE_URL_IDENTITY=mysql+pymysql://identity_app:identity_local@127.0.0.1:3306/identity
DATABASE_URL_NEO=mysql+pymysql://neo_app:neo_local@127.0.0.1:3306/neo
DATABASE_URL_WATCHLIST=mysql+pymysql://watchlist_app:watchlist_local@127.0.0.1:3306/watchlist
DATABASE_URL_MEDIA=mysql+pymysql://media_app:media_local@127.0.0.1:3306/media

# Mínimo 32 caracteres. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAME
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# DEMO_KEY funciona pero tiene un límite muy bajo. Registra la tuya gratis en https://api.nasa.gov
NASA_API_KEY=DEMO_KEY

# Orígenes del front que pueden llamar a la API, separados por comas
CORS_ORIGINS=http://localhost:5173
